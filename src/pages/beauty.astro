---
import beautyPouch from '@/assets/snugglegum-doypack-beauty-nutrition.png';
import BeautyBenefits from '@/components/sections/BeautyBenefits.astro';
import BeautyFaq from '@/components/sections/BeautyFaq.astro';
import BeautyHowItWorks from '@/components/sections/BeautyHowItWorks.astro';
import Footer from '@/components/sections/Footer.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import ProductHero from '@/components/product/ProductHero.astro';
import ProductNewsletter from '@/components/product/ProductNewsletter.astro';
import Base from '@/layouts/Base.astro';

const title = 'Snugglegum™ Beauty – Hair, Skin & Nail Nutrition Gummies';
const description =
  'Beauty is Snugglegum™’s Beauty Nutrition gummy: hair, skin and nail nutrition, engineered to get you closer. Coming soon, 18+, USA first.';
---

<Base title={title} description={description} path="/beauty" product={{ name: 'Snugglegum™ Beauty' }}>
  <main id="main" class="max-w-full overflow-x-clip">
    <ProductHero bgClass="bg-beauty" pouch={beautyPouch} pouchAlt="Snugglegum™ Beauty Nutrition pouch" tone="light">
      <Fragment slot="badge">Snugglegum™ · Beauty</Fragment>
      <Fragment slot="headline">Beauty nutrition, engineered in.</Fragment>
      <Fragment slot="subline">Beauty is Snugglegum™'s Beauty Nutrition gummy — hair, skin and nail support in a chewable dietary supplement, coming soon in the USA. 18+ only.</Fragment>
      <div slot="cta" class="flex justify-center">
        <ButtonLink href="#newsletter-beauty" variant="solid">Get on the list</ButtonLink>
      </div>
    </ProductHero>

    <BeautyHowItWorks />
    <BeautyBenefits />
    <BeautyFaq />

    <ProductNewsletter id="beauty" bgClass="bg-green" tone="dark" preselect="beauty">
      <span slot="badge" class="label-caps inline-block animate-none rounded-full border-2 border-dashed border-ink bg-white px-[22px] py-[13px] text-base text-ink">
        Pre-launch · list only
      </span>
      <h2 slot="heading" class="display-word stretch-display mt-6 text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88] text-balance">
        Ready to add it to your routine?
      </h2>
      <p slot="subline" class="mt-[30px] text-center text-2xl leading-[1.4] font-bold text-white">
        Join the list for early access and the pre-launch offer.
      </p>
    </ProductNewsletter>
  </main>
  <Footer />
</Base>
