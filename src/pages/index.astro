---
/**
 * Homepage: the pre-launch page. Claim, how it works (Snack. Burst. Vitamins.), the three-version
 * teasers, a founding-member callout, the FAQ and the founding-member signup (where founding members pick the first flavor).
 */
import AtAGlance from '@/components/home/AtAGlance.astro';
import Faq from '@/components/home/Faq.astro';
import Hero from '@/components/home/Hero.astro';
import Join from '@/components/home/Join.astro';
import HowItWorks from '@/components/home/HowItWorks.astro';
import SupplementFacts from '@/components/home/SupplementFacts.astro';
import Lines from '@/components/home/Lines.astro';
import Marquee from '@/components/home/Marquee.astro';
import Newsletter from '@/components/home/Newsletter.astro';
import Footer from '@/components/sections/Footer.astro';
import Brand from '@/components/ui/Brand.astro';
import Base from '@/layouts/Base.astro';
import { productLineMeta } from '@/lib/lines';

const title = 'Snugglegum™: Sweet Vitamins for Generations';
const description =
  'Sugar-free multivitamin gummies for every generation, with a liquid center that bursts when you bite. Coming soon to the USA. Join the first 500.';
---

<Base title={title} description={description} path="/" productLines={productLineMeta}>
  <main id="main" class="max-w-full overflow-x-clip">
    <Hero />
    <Marquee phrases={['Poppin’ vitamins', 'Snack', 'Burst', 'Vitamins', 'Sugar-free']} />
    <HowItWorks />
    <AtAGlance />
    <Lines />
    <Join />
    <Faq />

    <Newsletter id="home" bgClass="bg-green" tone="dark">
      <span slot="badge" class="label-caps inline-block animate-[sg-bob_4.5s_ease-in-out_infinite] rounded-full border-2 border-dashed border-ink bg-white pl-[calc(22px+0.14em)] pr-[22px] text-center py-[13px] text-base text-ink">
        Founding Member
      </span>
      <h2 slot="heading" class="display-word stretch-display mt-6 text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88] text-balance">
        Join the first 500 founding members.
      </h2>
      <p slot="subline" class="mx-auto mt-5 max-w-[40ch] text-xl leading-normal">Sign up for the <Brand /> newsletter and help us pick our first flavor.</p>
    </Newsletter>
  </main>
  <SupplementFacts />
  <Footer />
</Base>
