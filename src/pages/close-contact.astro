---
/**
 * Close Contact product page. This is the site's original, fullest product content, moved here
 * unchanged from the old single-product homepage (Hero, How It Works, the chemistry explainer,
 * What's Inside, Audience, Marquee, its own FAQ, the closing newsletter CTA and the Supplement
 * Facts dialog) so nothing approved gets rewritten in the process.
 */
import Audience from '@/components/sections/Audience.astro';
import CloseContactFaq from '@/components/sections/CloseContactFaq.astro';
import CloseContactChemistry from '@/components/sections/CloseContactChemistry.astro';
import CloseContactFinalCta from '@/components/sections/CloseContactFinalCta.astro';
import Footer from '@/components/sections/Footer.astro';
import CloseContactHero from '@/components/sections/CloseContactHero.astro';
import CloseContactHowItWorks from '@/components/sections/CloseContactHowItWorks.astro';
import CloseContactMarquee from '@/components/sections/CloseContactMarquee.astro';
import SupplementFacts from '@/components/sections/SupplementFacts.astro';
import CloseContactBenefits from '@/components/sections/CloseContactBenefits.astro';
import Base from '@/layouts/Base.astro';

const title = 'Snugglegum™ Close Contact – Close Contact Nutrition Gummies';
const description =
  "Close Contact is Snugglegum™'s Close Contact Nutrition gummy: liquid-filled, pineapple-flavored, engineered to get you closer. Coming soon, 18+, USA first.";
---

<Base title={title} description={description} path="/close-contact" product={{ name: 'Snugglegum™ Close Contact' }}>
  <main id="main" class="max-w-full overflow-x-clip">
    <CloseContactHero />
    <CloseContactHowItWorks />
    <CloseContactChemistry />
    <CloseContactBenefits />
    <Audience />
    <CloseContactMarquee />
    <CloseContactFaq />
    <CloseContactFinalCta />
  </main>
  <Footer />
  <SupplementFacts />
</Base>
