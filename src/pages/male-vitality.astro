---
import maleVitalityPouch from '@/assets/snugglegum-doypack-male-vitality.png';
import Footer from '@/components/sections/Footer.astro';
import MaleVitalityBenefits from '@/components/sections/MaleVitalityBenefits.astro';
import MaleVitalityChemistry from '@/components/sections/MaleVitalityChemistry.astro';
import MaleVitalityFaq from '@/components/sections/MaleVitalityFaq.astro';
import MaleVitalityHowItWorks from '@/components/sections/MaleVitalityHowItWorks.astro';
import Audience from '@/components/sections/Audience.astro';
import HeroSignup from '@/components/product/HeroSignup.astro';
import ProductMarquee from '@/components/product/ProductMarquee.astro';
import PouchStickers from '@/components/product/PouchStickers.astro';
import ProductHero from '@/components/product/ProductHero.astro';
import ProductNewsletter from '@/components/product/ProductNewsletter.astro';
import SupplementFacts from '@/components/sections/SupplementFacts.astro';
import Base from '@/layouts/Base.astro';

const title = 'Snugglegum™ Male Vitality – Intimate Male Fitness Gummies';
const description =
  'Male Vitality is Snugglegum™’s Intimate Male Fitness gummy: everyday nutritional support for men, engineered to get you closer. Coming soon, 18+, USA first.';
---

<Base title={title} description={description} path="/male-vitality" product={{ name: 'Snugglegum™ Male Vitality' }}>
  <main id="main" class="max-w-full overflow-x-clip">
    <ProductHero bgClass="bg-vitality" pouch={maleVitalityPouch} pouchAlt="Snugglegum™ Male Vitality pouch" pouchGlow="bg-pink/90" tone="dark">
      <Fragment slot="badge">Snugglegum™ · Male Vitality</Fragment>
      <Fragment slot="headline">Your Daily Dose of Male Confidence.</Fragment>
      <Fragment slot="subline">Male Vitality is Snugglegum’s daily gummy for men — made to support intimate male wellness, one chew at a time.<br>Join the list. You’ll want to be early.</Fragment>
      <PouchStickers slot="stickers" reviewNote="Male Vitality stickers are copied from Close Contact (the 93 count is a placeholder)" />
      <HeroSignup slot="cta" tone="dark" preselect="male-vitality" />
    </ProductHero>

    <MaleVitalityHowItWorks />
    <MaleVitalityChemistry />
    <MaleVitalityBenefits />
    <Audience />
    <ProductMarquee phrases={['Engineered for everyday vitality', 'Gummies with benefits', 'Begum tasty', 'Gum once, thank me later']} />
    <MaleVitalityFaq />

    <ProductNewsletter id="vitality" bgClass="bg-green" tone="dark" preselect="male-vitality">
      <span slot="badge" class="label-caps inline-block animate-[sg-bob_4.5s_ease-in-out_infinite] rounded-full border-2 border-dashed border-ink bg-white px-[22px] py-[13px] text-base text-ink">
        Pre-launch · list only
      </span>
      <h2 slot="heading" class="display-word stretch-display mt-6 text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88] text-balance">
        Ready for the everyday edge?
      </h2>
      <p slot="subline" class="mt-[30px] text-center text-2xl leading-[1.4] font-bold text-white">
        Join the list for the pre-launch offer: free shipping on your first order.
      </p>
    </ProductNewsletter>
  </main>
  <Footer />
  <SupplementFacts />
</Base>
