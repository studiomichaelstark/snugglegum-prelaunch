---
import maleVitalityPouch from '@/assets/snugglegum-doypack-male-vitality.png';
import Footer from '@/components/sections/Footer.astro';
import MaleVitalityBenefits from '@/components/sections/MaleVitalityBenefits.astro';
import MaleVitalityFaq from '@/components/sections/MaleVitalityFaq.astro';
import MaleVitalityHowItWorks from '@/components/sections/MaleVitalityHowItWorks.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import ProductHero from '@/components/product/ProductHero.astro';
import ProductNewsletter from '@/components/product/ProductNewsletter.astro';
import Base from '@/layouts/Base.astro';

const title = 'Snugglegum™ Male Vitality – Intimate Male Fitness Gummies';
const description =
  'Male Vitality is Snugglegum™’s Intimate Male Fitness gummy: everyday nutritional support for men, engineered to get you closer. Coming soon, 18+, USA first.';
---

<Base title={title} description={description} path="/male-vitality" product={{ name: 'Snugglegum™ Male Vitality' }}>
  <main id="main" class="max-w-full overflow-x-clip">
    <ProductHero bgClass="bg-vitality" pouch={maleVitalityPouch} pouchAlt="Snugglegum™ Male Vitality pouch" tone="dark">
      <Fragment slot="badge">Snugglegum™ · Male Vitality</Fragment>
      <Fragment slot="headline">Engineered for everyday vitality.</Fragment>
      <Fragment slot="subline">Male Vitality is Snugglegum™'s Intimate Male Fitness gummy — a chewable dietary supplement for men, coming soon in the USA. 18+ only.</Fragment>
      <div slot="cta" class="flex justify-center">
        <ButtonLink href="#newsletter-vitality" variant="on-dark">Get on the list</ButtonLink>
      </div>
    </ProductHero>

    <MaleVitalityHowItWorks />
    <MaleVitalityBenefits />
    <MaleVitalityFaq />

    <ProductNewsletter id="vitality" bgClass="bg-green" tone="dark" preselect="male-vitality">
      <span slot="badge" class="label-caps inline-block animate-none rounded-full border-2 border-dashed border-ink bg-white px-[22px] py-[13px] text-base text-ink">
        Pre-launch · list only
      </span>
      <h2 slot="heading" class="display-word stretch-display mt-6 text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88] text-balance">
        Ready for the everyday edge?
      </h2>
      <p slot="subline" class="mt-[30px] text-center text-2xl leading-[1.4] font-bold text-white">
        Join the list for early access and the pre-launch offer.
      </p>
    </ProductNewsletter>
  </main>
  <Footer />
</Base>
