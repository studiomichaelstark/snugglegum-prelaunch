---
import ArrowIcon from "@/components/ui/ArrowIcon.astro";

interface Props {
  /** "Who it's for" entries. Defaults to the brand-wide list; a product page can bring its own. */
  forItems?: string[];
  /** "Who it's not" entries (after the optional age line). Defaults to the brand-wide list. */
  notItems?: string[];
}
const {
  forItems = [
    "Gym regulars who read every label.",
    "Date-night optimists.",
    "People who don't do boring.",
    "Anyone with good taste and questionable jokes.",
  ],
  notItems = ["The easily offended.", "People who think pineapple on pizza is the real scandal."],
} = Astro.props;

const item = "flex items-start gap-3.5";
const box = "rounded-card p-[clamp(28px,3.5vw,48px)]";
const heading = "display-word mt-3 text-[clamp(2rem,3.5vw,3rem)] leading-[0.92] tracking-normal stretch-hero";
---

<section id="audience" class="section-px section-py bg-white">
  <div class="container-lg grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[clamp(16px,2vw,24px)]">
    <div class:list={[box, "bg-green text-pink"]}>
      <p class="label-caps text-[17px]">Yes</p>
      <h2 class:list={[heading]}>Who it's for</h2>
      <ul class="mt-[26px] grid gap-4 text-xl leading-[1.4]">
        {forItems.map((text) => (
          <li class:list={[item]}>
            <ArrowIcon class="mt-[0.3em] text-pink" />
            <span>{text}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class:list={[box, "bg-pink text-green"]}>
      <p class="label-caps text-[17px]">Not really</p>
      <h2 class:list={[heading]}>Who it's not</h2>
      <ul class="mt-[26px] grid gap-4 text-xl leading-[1.4]">
        {notItems.map((text) => (
          <li class:list={[item]}>
            <ArrowIcon class="mt-[0.3em]" />
            <span>{text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
