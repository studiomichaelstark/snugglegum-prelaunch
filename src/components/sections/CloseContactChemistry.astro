---
/**
 * "The chemistry of getting close" — a short editorial explainer between How It Works and
 * What's Inside. Four connected text blocks (dashed dividers, same language as HowItWorks/
 * WhatsInside/Faq) that build from a playful hook to the nutritional explanation to a cheeky
 * close. Bold leads carry the scan-only hierarchy the copy brief asked for.
 *
 * Several sentences make body/attraction/ingredient claims (same category as the existing
 * flagged copy in Hero, HowItWorks and WhatsInside), so they carry data-copy-review and are
 * listed by `pnpm check:placeholders`, which blocks the production build until approved.
 */
const h3 = "text-[26px] leading-[1.05] font-black uppercase";
const body = "mt-2 text-xl leading-[1.6]";
const block = "border-t-2 border-dashed border-green pt-[clamp(24px,3vw,40px)]";
---

<section id="chemistry-of-getting-close" class="section-px section-py bg-white">
  <div class="container-lg">
    <div class="mx-auto max-w-[760px]">
      <p class="label-caps flex items-center gap-3 text-[17px] text-green">
        <span aria-hidden="true" class="size-2.5 flex-none animate-[sg-blink_1.6s_ease-in-out_infinite] rounded-full bg-green"></span>
        The chemistry of getting close
      </p>

      <h2 class="display-word stretch-display mt-4 text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88]">Attraction starts before the first kiss.</h2>

      <div class="mt-[clamp(28px,3vw,44px)] grid gap-[clamp(20px,3vw,32px)]">
        <p class="text-xl leading-[1.6]" data-copy-review="body-odor / attraction claim">
          You know the saying: you have to like <strong>someone's smell</strong>. Your natural scent is influenced by what you eat, how your body processes nutrients and the compounds your body naturally produces.
          <strong>Snugglegum<sup class="text-[0.55em]">™</sup> is designed to work with that chemistry — not cover it up with perfume.</strong>
        </p>

        <div class:list={[block]}>
          <h3 class:list={[h3]}>Your skin isn't the whole story.</h3>
          <p class:list={[body]} data-copy-review="body fluid claim">
            Breath, sweat, saliva and the other <strong>body fluids</strong> involved in getting really close all have their own chemistry. What goes into your body can become part of that chemistry, too.
          </p>
        </div>

        <div class:list={[block]}>
          <h3 class:list={[h3]}>
            That's where Snugglegum<sup class="text-[0.55em]">™</sup> comes in.
          </h3>
          <p class:list={[body]} data-copy-review="ingredient benefit claim (zinc: metabolism, skin, taste perception)">
            Its combination of ingredients provides nutritional support for processes your body already relies on. Zinc, for example, contributes to normal metabolism and the maintenance of normal skin and plays a role in normal taste perception.
          </p>
        </div>

        <div class:list={[block]}>
          <p class="text-xl leading-[1.6]">
            It doesn't replace good food, hydration or basic hygiene. <strong>It's the little extra</strong> — for the days when dinner was fries, lunch was questionable and "I'll eat better tomorrow" somehow became a lifestyle.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
