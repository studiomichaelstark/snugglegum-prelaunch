---
/**
 * Homepage hero: the Snugglegum™ umbrella brand — logo, tagline, headline, subline and the
 * pouch-trio visual. No animation anywhere in this component (the brief requires this
 * specifically for the homepage hero) — hover feedback on buttons elsewhere is interaction-driven,
 * not auto-playing. The three product cards live in their own section, ProductFamily.astro,
 * directly below this one.
 */
import { Picture } from "astro:assets";
import Logo from "@/components/logo/Logo.astro";
import pouchTrio from "@/assets/snugglegum-pouch-trio.png";
import Brand from "@/components/ui/Brand.astro";
---

<section id="hero" class="section-px relative isolate bg-pink pt-9 pb-[clamp(56px,7vw,96px)] text-green">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-radial from-transparent from-75% to-vignette-close-contact opacity-45"></div>
  <div class="container-lg text-center">
    <div class="flex justify-center pt-6 pb-0">
      <Logo class="logo-glow logo-hero text-white" />
    </div>
    <p class="label-caps mt-2 text-sm">Engineered to make you gum.</p>
    <h1 class="display-word stretch-hero mx-auto mt-[40px] max-w-[20ch] text-[clamp(2.5rem,6.5vw,5.5rem)] leading-[0.9] text-balance">Gummies With Benefits. Literally.</h1>
    <p class="mx-auto mt-5 mb-8 max-w-[52ch] text-[clamp(1.15rem,1.7vw,1.4rem)] leading-[1.5] font-medium">
      <strong>
        <Brand /> is a family of functional gummies
      </strong>
      .<br />
      Not on the shelves yet. Join the list and we’ll let you know when they’re ready to chew.
    </p>
  </div>

  <!-- Page width, not full-bleed: same .container-lg the text column above uses (1200px cap), not the viewport edge. -->
  <div class="container-lg mt-[clamp(4px,0.5vw,6.5px)]">
    <Picture src={pouchTrio} alt="" formats={["avif", "webp"]} widths={[480, 768, 1024, 1200]} sizes="(min-width: 1296px) 1200px, 100vw" loading="eager" fetchpriority="high" class="h-auto w-full" />
    <p class="mt-3 text-center text-base">(Product shown reflects current development. Final packaging may be updated prior to launch)</p>
  </div>
</section>
