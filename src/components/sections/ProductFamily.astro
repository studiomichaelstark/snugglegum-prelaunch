---
/**
 * Homepage product grid: the three product cards (pouch, name, one-line pitch, CTA), directly
 * below FamilyHero.astro. Split out as its own section so the hero can stay a short brand
 * moment. White background (the hero's pink and its vignette stay confined to #hero, not carried
 * over here); text-green for the card copy that still relies on the ambient color.
 */
import { Picture } from 'astro:assets';
import closeContactPouch from '@/assets/snugglegum-doypack-close-contact.png';
import proteinEnergyPouch from '@/assets/snugglegum-doypack-protein-energy.png';
import beautyPouch from '@/assets/snugglegum-doypack-beauty-nutrition.png';
import ButtonLink from '@/components/ui/ButtonLink.astro';
---

<section id="products" class="section-px section-py bg-white text-green">
  <div class="container-lg">
    <ul class="grid grid-cols-1 gap-5 text-left sm:grid-cols-3">
      <li class="rounded-card flex flex-col items-center text-center sm:row-span-5 sm:grid sm:grid-rows-subgrid sm:items-stretch sm:gap-y-0 p-[clamp(24px,3vw,32px)] sm:p-[clamp(14px,3vw,32px)]">
        <a href="/close-contact" tabindex="-1" aria-hidden="true" class="relative isolate mx-auto mb-6 block w-full max-w-[380px]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-[2%_-12%] -z-10 rounded-full bg-white/90 blur-[30px] md:blur-[40px]"></div>
          <Picture
            src={closeContactPouch}
            alt=""
            formats={["avif", "webp"]}
            widths={[320, 480, 771]}
            sizes="(min-width: 768px) 30vw, 80vw"
            class="block h-auto w-full"
          />
        </a>
        <p class="label-caps text-sm text-ink">Close Contact</p>
        <h2 class="mt-2 text-2xl sm:text-[clamp(1rem,2.4vw,1.5rem)] text-green font-black uppercase leading-[1.05]">Close Contact Nutrition</h2>
        <p class="mt-2.5 text-lg text-ink leading-normal">
          Body taste is biochemistry — and there's something you can do about it.
        </p>
        <ButtonLink href="/close-contact" size="sm" class="mt-6 px-4 sm:justify-self-center">Learn more<span class="sr-only"> about Close Contact</span></ButtonLink>
      </li>

      <li class="rounded-card flex flex-col items-center text-center sm:row-span-5 sm:grid sm:grid-rows-subgrid sm:items-stretch sm:gap-y-0 p-[clamp(24px,3vw,32px)] sm:p-[clamp(14px,3vw,32px)]">
        <a href="/beauty" tabindex="-1" aria-hidden="true" class="relative isolate mx-auto mb-6 block w-full max-w-[380px]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-[2%_-12%] -z-10 rounded-full bg-white/90 blur-[30px] md:blur-[40px]"></div>
          <Picture
            src={beautyPouch}
            alt=""
            formats={["avif", "webp"]}
            widths={[320, 480, 771]}
            sizes="(min-width: 768px) 30vw, 80vw"
            class="block h-auto w-full"
          />
        </a>
        <p class="label-caps text-sm text-ink">Beauty</p>
        <h2 class="mt-2 text-2xl sm:text-[clamp(1rem,2.4vw,1.5rem)] font-black uppercase leading-[1.05]">Beauty<br>Nutrition</h2>
        <p class="mt-2.5 text-lg text-ink leading-normal">Hair, skin and nail nutrition, built into an everyday gummy.</p>
        <ButtonLink href="/beauty" size="sm" class="mt-6 px-4 sm:justify-self-center">Learn more<span class="sr-only"> about Beauty</span></ButtonLink>
      </li>

      <li class="on-dark rounded-card flex flex-col items-center text-center sm:row-span-5 sm:grid sm:grid-rows-subgrid sm:items-stretch sm:gap-y-0 p-[clamp(24px,3vw,32px)] sm:p-[clamp(14px,3vw,32px)] text-white">
        <a href="/protein-energy" tabindex="-1" aria-hidden="true" class="relative isolate mx-auto mb-6 block w-full max-w-[380px]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-[2%_-12%] -z-10 rounded-full bg-white/90 blur-[30px] md:blur-[40px]"></div>
          <Picture
            src={proteinEnergyPouch}
            alt=""
            formats={["avif", "webp"]}
            widths={[320, 480, 771]}
            sizes="(min-width: 768px) 30vw, 80vw"
            class="block h-auto w-full"
          />
        </a>
        <p class="label-caps text-sm text-ink">Protein Energy</p>
        <h2 class="mt-2 text-2xl sm:text-[clamp(1rem,2.4vw,1.5rem)] text-green font-black uppercase leading-[1.05]">Protein Sport Nutrition</h2>
        <p class="mt-2.5 text-lg text-ink leading-normal" data-copy-review="PENDING - Protein. Energy. and No shaker required. match the positioning line on Notion Produkt & Rezeptur; Zero sugar conflicts with the 5 g glucose target in Regulatory & Compliance §5 (see the zero sugar note on the Protein Energy page).">Protein. Energy. Zero sugar. No shaker required.</p>
        <ButtonLink href="/protein-energy" size="sm" class="mt-6 px-4 sm:justify-self-center">Learn more<span class="sr-only"> about Protein Energy</span></ButtonLink>
      </li>
    </ul>
  </div>
</section>
