---
/** Homepage-only: brand-level differentiators (no product-specific ingredient claims). */
import ProductBenefit from '@/components/product/ProductBenefit.astro';
---

<section id="why-snugglegum" class="section-px section-py bg-white">
  <div class="container-lg">
    <h2 class="display-word text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88] stretch-display">
      Why Snugglegum<sup class="text-[0.4em]">™</sup>
    </h2>
  </div>

  <div class="container-lg mt-5 grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[clamp(32px,5vw,72px)]">
    <div>
      <p class="max-w-[36ch] text-xl leading-normal">One family, one attitude, three ways to get closer.</p>
    </div>

    <div>
      <ul>
        <ProductBenefit>
          <Fragment slot="name">One family, one attitude</Fragment>
          <Fragment slot="description">
            Cheeky, confident and never boring — every Snugglegum<sup class="text-[0.55em]">™</sup> product is built with the same
            voice and the same standards.
          </Fragment>
        </ProductBenefit>
        <ProductBenefit>
          <Fragment slot="name">Real ingredients, named</Fragment>
          <Fragment slot="description">No mystery blends. Every formula lists exactly what's inside, in amounts you can check.</Fragment>
        </ProductBenefit>
        <ProductBenefit>
          <Fragment slot="name">The list gets it first</Fragment>
          <Fragment slot="description">
            Every Snugglegum<sup class="text-[0.55em]">™</sup> product launches to the pre-launch list before it goes public —
            discount, early access and a founding number included.
          </Fragment>
        </ProductBenefit>
        <ProductBenefit>
          <Fragment slot="name">18+, on purpose</Fragment>
          <Fragment slot="description">Because our humor is.</Fragment>
        </ProductBenefit>
      </ul>
    </div>
  </div>
</section>
