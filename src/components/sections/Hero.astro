---
/**
 * Close Contact hero: the copy, stickers and inline signup for the shared product hero shell.
 */
import pouch from "@/assets/snugglegum-doypack-close-contact.png";
import NewsletterForm from "@/components/forms/NewsletterForm.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import { siteConfig } from "@/config/site";
import { shouldShowSocialProof } from "@/config/variants";

const showProof = shouldShowSocialProof(siteConfig.subscriberCount, siteConfig.proofThreshold);

const sticker = "sticker-shadow absolute z-[2] font-bold leading-[1.3] tracking-[0.06em] text-ink uppercase text-center text-[clamp(12px,1.15vw,16px)] border-2 border-dashed border-ink bg-white";
---

<ProductHero bgClass="bg-pink" tone="light" pouch={pouch} pouchAlt="Snugglegum™ Close Contact pouch of liquid-filled pineapple gummies">
  <Fragment slot="badge">Coming soon</Fragment>
  <Fragment slot="headline">For kisses that don't stop at the lips.</Fragment>
  <Fragment slot="subline">Liquid-filled pineapple gummies. They haven't launched yet. The list is how you get in first.</Fragment>

  <Fragment slot="stickers">
    <span class:list={[sticker, "top-[calc(8%+110px)] left-[-14%] w-[120px] [transform:rotate(-8deg)] rounded-[10px] px-[14px] py-[11px] animate-[sg-float_5.5s_ease-in-out_infinite] [--r:-8deg] md:w-[150px] md:px-[18px] md:py-3.5"]}>
      93 chews
      <br />
      inside
    </span>

    <span class:list={[sticker, "bottom-5 left-[-2%] flex size-[112px] [transform:rotate(-5deg)] items-center justify-center rounded-full p-2 animate-[sg-float_8s_ease-in-out_infinite] [--r:-5deg] md:size-[140px] md:p-[22px]"]}>
      You know why
      <br />
      pineapple
    </span>
  </Fragment>

  <Fragment slot="cta">
    <NewsletterForm id="hero" tone="light" preselect="close-contact">
      <p slot="after-error" data-copy-review="body-taste guide mention" class="mt-3.5 text-center text-2xl leading-[1.4] font-bold">
        Free with sign-up: the "Body Taste Cheat Code" guide.
      </p>
    </NewsletterForm>

    {showProof && (
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3.5">
        <span class="inline-flex items-center gap-2.5 text-base font-bold">
          <span class="inline-flex" aria-hidden="true">
            <span class="size-8 rounded-full border-2 border-green bg-lime" />
            <span class="-ml-2.5 size-8 rounded-full border-2 border-green bg-pink" />
            <span class="-ml-2.5 size-8 rounded-full border-2 border-green bg-ink" />
          </span>
          {siteConfig.subscriberCount} people are already on the list
        </span>
      </div>
    )}
  </Fragment>
</ProductHero>
