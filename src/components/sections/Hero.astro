---
import { Picture } from 'astro:assets';
import pouch from '@/assets/snugglegum-doypack.png';
import Logo from '@/components/logo/Logo.astro';
import StampBadge from '@/components/logo/StampBadge.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import PdfIcon from '@/components/ui/PdfIcon.astro';
import { siteConfig } from '@/config/site';
import { shouldShowSocialProof } from '@/config/variants';

const showProof = shouldShowSocialProof(siteConfig.subscriberCount, siteConfig.proofThreshold);

const sticker =
  'sticker-shadow absolute z-[2] font-bold leading-[1.3] tracking-[0.06em] text-ink uppercase text-center text-[clamp(12px,1.15vw,16px)] border-2 border-dashed border-ink bg-white';
---

<section id="hero" class="relative overflow-hidden bg-pink px-[clamp(20px,5vw,48px)] pt-9 pb-[clamp(56px,7vw,96px)]">
  <div class="relative mx-auto max-w-[1200px]">
    <div class="flex justify-center">
      <Logo class="logo-glow w-[min(92%,880px)] text-white" />
    </div>

    <div class="mt-[clamp(28px,4vw,44px)] flex flex-wrap items-center justify-center gap-[clamp(16px,3vw,32px)]">
      <span
        class="m-auto inline-block animate-[sg-bob_4s_ease-in-out_infinite] rounded-full bg-ink px-8 py-[18px] text-[clamp(12.8px,1.76vw,20.8px)] font-black tracking-[0.12em] text-pink uppercase font-stretch-[112%]"
      >
        Coming soon
      </span>
    </div>

    <h1
      class="mx-auto mt-[clamp(28px,4vw,44px)] max-w-[16ch] text-center text-[clamp(2.5rem,6.5vw,5.5rem)] leading-[0.9] font-black tracking-[-0.02em] text-balance uppercase font-stretch-[118%]"
    >
      For kisses that don't stop at the lips.
    </h1>

    <p class="mx-auto mt-[clamp(18px,2.5vw,26px)] max-w-[48ch] text-center text-[clamp(1.15rem,1.7vw,1.4rem)] leading-[1.5] font-medium">
      Liquid-filled pineapple gummies. They haven't launched yet. The list is how you get in first.
    </p>

    <div class="relative mt-[clamp(28px,4vw,48px)]">
      <div
        aria-hidden="true"
        class="ml-[calc(50%-50vw)] w-screen text-center text-[clamp(3.2rem,15vw,13rem)] leading-[0.8] font-black tracking-[-0.035em] opacity-[0.14] font-stretch-[125%]"
      >
        GUMMIES
      </div>

      <div class="relative mt-[clamp(-80px,-9vw,-36px)] flex justify-center">
        <div class="relative aspect-[746/964] w-[min(100%,520px)] animate-[sg-bob_7s_ease-in-out_infinite]">
          <Picture
            src={pouch}
            alt="Snugglegum™ pouch of liquid-filled pineapple gummies"
            formats={['avif', 'webp']}
            widths={[390, 520, 746]}
            sizes="(min-width: 640px) 520px, 92vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 block size-full border-0 object-cover"
          />

          <span
            class:list={[sticker, 'top-[calc(8%+110px)] left-[-14%] w-[150px] [transform:rotate(-8deg)] rounded-[10px] px-[18px] py-3.5 animate-[sg-float_5.5s_ease-in-out_infinite] [--r:-8deg]']}
          >
            93 chews<br />inside
          </span>

          <StampBadge
            class="absolute top-[44%] right-[calc(-4%-40px)] z-[2] size-[130px] [transform:rotate(7deg)] text-white animate-[sg-float_6.8s_ease-in-out_infinite] [--r:7deg]"
          />

          <span
            class:list={[sticker, 'bottom-5 left-[-2%] flex size-[140px] [transform:rotate(-5deg)] items-center justify-center rounded-full p-[22px] animate-[sg-float_8s_ease-in-out_infinite] [--r:-5deg]']}
          >
            You know why<br />pineapple
          </span>
        </div>
      </div>
    </div>

    <div class="mx-auto mt-[clamp(28px,4vw,44px)] max-w-[660px]">
      <NewsletterForm id="hero" tone="light">
        <p
          slot="after-error"
          data-copy-review="body-taste guide mention"
          class="mt-3.5 flex items-center justify-center gap-2 text-center text-2xl leading-[1.4] font-bold"
        >
          Free with sign-up: the "Body Taste Cheat Code" guide.
          <PdfIcon />
        </p>
      </NewsletterForm>

      {
        showProof && (
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3.5">
            <span class="inline-flex items-center gap-2.5 text-base font-bold">
              <span class="inline-flex" aria-hidden="true">
                <span class="size-8 rounded-full border-2 border-green bg-lime" />
                <span class="-ml-2.5 size-8 rounded-full border-2 border-green bg-pink" />
                <span class="-ml-2.5 size-8 rounded-full border-2 border-green bg-ink" />
              </span>
              {siteConfig.subscriberCount} people are already on the list
            </span>
          </div>
        )
      }
    </div>
  </div>
</section>
