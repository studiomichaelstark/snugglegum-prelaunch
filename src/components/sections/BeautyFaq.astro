---
/**
 * Beauty's dedicated FAQ. Like Male Vitality, this product has no approved ingredient/claim
 * content yet, so answers stay conservative — no invented cosmetic or medical claims about hair,
 * skin or nails — and formula-specific answers carry data-copy-review (the site's existing
 * mechanism for copy pending approval, see CloseContactFaq.astro), so they stay visible as flagged,
 * honest placeholders instead of invented claims.
 */
import ProductFaqGroup from '@/components/product/ProductFaqGroup.astro';

const item = 'border-b-2 border-dashed border-green';
const question = 'flex min-h-12 items-center justify-between gap-5 py-6 text-[clamp(1.15rem,2vw,1.5rem)] font-black uppercase';
const plus = 'faq-plus flex-none text-[26px] font-black';
const answer = 'max-w-[60ch] pb-6 text-[19px] leading-[1.55]';
---

<section id="faq" class="section-px section-py bg-beauty">
  <div class="mx-auto max-w-[900px]">
    <h2 class="display-word stretch-display text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88]">Beauty, answered</h2>

    <div class="mt-[clamp(40px,5vw,64px)]">
      <ProductFaqGroup badgeClass="bg-green text-pink">
        <span slot="badge">Beauty</span>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>
              What is Snugglegum<sup class="text-[0.55em]">™</sup> Beauty?
            </span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>
            Beauty is a chewable dietary supplement built around hair, skin and nail nutrition — the everyday kind, in
            a gummy you'll actually want to take.
          </p>
        </details>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>What does "Beauty Nutrition" mean?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>
            It's how we describe what Beauty is for: nutritional support for hair, skin and nails, as part of an
            everyday routine. It's a dietary supplement, not a cosmetic treatment.
          </p>
        </details>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>What ingredients are in Beauty?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]} data-copy-review="Beauty ingredient list not yet finalized">
            The full ingredient list isn't finalized yet. Once it is, it'll be published here and on the Supplement Facts panel.
          </p>
        </details>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>What does Beauty taste like?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]} data-copy-review="Beauty flavor not yet finalized">
            The flavor hasn't been finalized yet — we'll confirm it here before launch.
          </p>
        </details>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>How many should I take?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]} data-copy-review="Beauty serving size not yet finalized">
            The recommended serving size will be confirmed once the formula is final. The label will always be the definitive
            source.
          </p>
        </details>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>Is Beauty safe?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>
            Beauty will be formulated and manufactured as a dietary supplement according to the requirements
            applicable to its launch market. Follow the labeled serving size and speak with a healthcare professional
            if you have a medical condition, are pregnant or breastfeeding, or take medications.
          </p>
        </details>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>Why is Beauty 18+?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>Because our humor is — same as the rest of the Snugglegum™ family.</p>
        </details>

        <details name="faq-beauty" class:list={[item]}>
          <summary class:list={[question]}>
            <span>When does Beauty launch?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>Soon, on the same pre-launch list as the rest of the Snugglegum™ family. Join to hear first.</p>
        </details>
      </ProductFaqGroup>
    </div>
  </div>
</section>
