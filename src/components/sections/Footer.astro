---
import ContactEmail from "@/components/legal/ContactEmail.astro";
import Logo from "@/components/logo/Logo.astro";
import OperatorInfo from "@/components/legal/OperatorInfo.astro";
import ArrowUpIcon from "@/components/ui/ArrowUpIcon.astro";
import Brand from "@/components/ui/Brand.astro";

const year = new Date().getFullYear();
const footLink = "inline-flex min-h-11 cursor-pointer items-center text-[15px] underline";
---

<footer id="footer">
  <div class="section-px bg-pink pt-[clamp(4rem,8vw,7rem)] pb-[clamp(3rem,5vw,4rem)]">
    <div class="container-lg">
      <div class="mx-auto grid max-w-[760px] gap-3.5 text-center text-green">
        <p class="text-[17px] leading-[1.6] opacity-90">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
        <p class="text-[17px] leading-[1.6] opacity-90">Contact: <ContactEmail /></p>
        <p class="text-[17px] leading-[1.6] opacity-90">
          <Brand /> is a trademark by
          <OperatorInfo variant="name" />
        </p>
      </div>
    </div>
    <div class="mt-[clamp(48px,7vw,80px)]">
      <Logo class="container-lg text-green" />
      <nav aria-label="Legal" class="mt-[clamp(32px,5vw,48px)] flex flex-wrap justify-center gap-x-7 gap-y-2">
        <a href="/imprint" class:list={[footLink]}> Imprint </a>
        <a href="/privacy" class:list={[footLink]}> Privacy </a>
        <button type="button" data-open-cookie-settings class:list={[footLink]}> Cookie settings </button>
      </nav>
    </div>
  </div>

  <div class="on-dark flex flex-wrap items-center justify-between gap-3.5 bg-ink px-5 py-[26px] max-md:pr-[86px]">
    <p class="w-full text-[17px] font-bold tracking-[0.02em] text-ink-muted text-center md:w-auto md:text-left">
      ©{year}by
      <OperatorInfo variant="name" />. All rights reserved.
    </p>
  </div>

  <!-- Fixed to the viewport corner on every page, whatever the scroll position. Ink fill + pink ring so it reads on pink, white and green sections alike. -->
  <a
    href="#top"
    aria-label="Back to top"
    class="fixed right-4 bottom-4 z-40 inline-flex size-[50px] items-center justify-center rounded-full border-2 border-pink bg-ink text-pink no-underline shadow-[0_8px_20px_color-mix(in_srgb,var(--color-brand-ink)_32%,transparent)] transition duration-200 hover:-translate-y-[3px] hover:scale-[1.03] hover:border-green hover:bg-white hover:text-green md:right-6 md:bottom-6"
  >
    <ArrowUpIcon />
  </a>
</footer>
