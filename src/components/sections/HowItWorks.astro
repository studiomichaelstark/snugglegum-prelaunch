---
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';

const row =
  'grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] items-center gap-[clamp(20px,3vw,40px)] border-t-2 border-dashed border-white/20 pt-[clamp(24px,3vw,40px)]';
const number = 'text-[clamp(4rem,9vw,8rem)] leading-[0.75] font-black text-pink font-stretch-125';
const title = 'mt-[18px] text-[clamp(2rem,3.5vw,3rem)] leading-[0.95] font-black uppercase font-stretch-[118%]';
const body = 'mt-3.5 max-w-[38ch] text-xl leading-normal';
---

<section id="how-it-works" class="on-dark overflow-hidden bg-ink px-[clamp(20px,5vw,48px)] py-[clamp(4rem,10vw,8rem)] text-white">
  <div class="mx-auto max-w-[1200px]">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="display-word text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88] text-pink font-stretch-[120%]">How it works</h2>
      <p class="max-w-[34ch] text-xl leading-[1.4]" data-copy-review="body-taste claim">
        Body taste isn't hygiene. It's biochemistry — and it's fixable.
      </p>
    </div>

    <ol class="mt-[clamp(40px,5vw,72px)] grid gap-[clamp(20px,3vw,32px)]">
      <li class:list={[row]}>
        <div>
          <div class="flex items-center gap-4">
            <span aria-hidden="true" class:list={[number]}>01</span>
            <span aria-hidden="true" class="size-3.5 animate-[sg-blink_1.6s_ease-in-out_infinite] rounded-full bg-pink"></span>
          </div>
          <h3 class:list={[title]}>It starts with digestion</h3>
          <p class:list={[body]} data-copy-review="body-odor claim">
            Breaking down proteins and amino acids can release compounds through sweat, saliva and other fluids — shaping
            how you come across up close. Your body isn't doing anything wrong. It's just doing biochemistry.
          </p>
        </div>
        <div class="aspect-[4/3] transition-transform duration-300 hover:scale-[1.03] hover:-rotate-1">
          <ImagePlaceholder />
        </div>
      </li>

      <li class:list={[row]}>
        <div class="order-2">
          <div class="flex items-center gap-4">
            <span aria-hidden="true" class:list={[number]}>02</span>
            <span aria-hidden="true" class="relative size-6">
              <span class="absolute inset-0 animate-[sg-burst_1.8s_ease-out_infinite] rounded-full border-2 border-pink"></span>
              <span class="absolute inset-1.5 rounded-full bg-pink"></span>
            </span>
          </div>
          <h3 class:list={[title]}>Brushing is only the start</h3>
          <p class:list={[body]} data-copy-review="ingredient benefit claim">
            Oral hygiene helps, but taste starts before the mouth — hydration, food, metabolism. Zinc, maca and L-arginine
            support a more balanced system, so there's simply less to mask.
          </p>
        </div>
        <div class="order-1 aspect-[4/3] transition-transform duration-300 hover:scale-[1.03] hover:rotate-1">
          <ImagePlaceholder />
        </div>
      </li>

      <li class:list={[row]}>
        <div>
          <div class="flex items-center gap-4">
            <span aria-hidden="true" class:list={[number]}>03</span>
            <span aria-hidden="true" class="relative size-6">
              <span class="absolute inset-0 animate-[sg-burst_1.8s_ease-out_infinite] rounded-full border-2 border-pink"></span>
              <span class="absolute inset-1.5 rounded-full bg-pink"></span>
            </span>
          </div>
          <h3 class:list={[title]}>Make it a rhythm</h3>
          <p class:list={[body]}>
            One a day, most days. Like brushing your teeth, the effect builds with consistency — not a single hit, a habit.
          </p>
        </div>
        <div class="aspect-[4/3] transition-transform duration-300 hover:scale-[1.03] hover:-rotate-1">
          <ImagePlaceholder />
        </div>
      </li>
    </ol>
  </div>
</section>
