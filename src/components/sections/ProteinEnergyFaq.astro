---
/**
 * Protein Energy's dedicated FAQ. The formula is not final (no amounts, no complete ingredient list), so
 * the formula-specific answers carry data-copy-review — the site's existing mechanism for copy pending
 * approval (see CloseContactFaq.astro) — and stay visible as flagged, honest placeholders.
 */
import ProductFaqGroup from '@/components/product/ProductFaqGroup.astro';
import Brand from '@/components/ui/Brand.astro';

const item = 'border-b-2 border-dashed border-white/20';
const question = 'flex min-h-12 items-center justify-between gap-5 py-6 text-[clamp(1.15rem,2vw,1.5rem)] font-black uppercase';
const plus = 'faq-plus flex-none text-[26px] font-black';
const answer = 'max-w-[60ch] pb-6 text-[19px] leading-[1.55]';
---

<section id="faq" class="on-dark section-px section-py bg-sport text-white">
  <div class="mx-auto max-w-[900px]">
    <h2 class="display-word stretch-display text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88] text-pink">Protein Energy, answered</h2>

    <div class="mt-[clamp(40px,5vw,64px)]">
      <ProductFaqGroup badgeClass="bg-pink text-ink">
        <span slot="badge">Protein Energy</span>

        <details name="faq-protein-energy" class:list={[item]}>
          <summary class:list={[question]}>
            <span>
              What is <Brand /> Protein Energy?
            </span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>
            Protein Energy is a high-protein, zero-sugar gummy loaded with protein, fast carbs and a kick of caffeine — made for
            workouts, busy days and whenever your body wants fuel without the boring routine. No powder, no shaker, no
            sad protein bar.
          </p>
        </details>

        <details name="faq-protein-energy" class:list={[item]}>
          <summary class:list={[question]}>
            <span>What does "Protein Sport Nutrition" mean?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>
            It's how we describe what Protein Energy is for: protein for anyone who trains, in a format that's easy
            to actually stick with. It's a dietary supplement, not a medical treatment, and it isn't a substitute
            for a doctor's advice.
          </p>
        </details>

        <details name="faq-protein-energy" class:list={[item]}>
          <summary class:list={[question]}>
            <span>What ingredients are in Protein Energy?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]} data-copy-review="Protein Energy ingredient list not yet finalized">
            Protein Energy combines protein with glucose, caffeine and selected energy-supporting ingredients. The full
            ingredient list and the amounts aren't finalized yet. Once they are, they'll be published here and on the
            Supplement Facts panel.
          </p>
        </details>

        <details name="faq-protein-energy" class:list={[item]}>
          <summary class:list={[question]}>
            <span>How many should I take?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]} data-copy-review="Protein Energy serving size not yet finalized">
            The recommended serving size will be confirmed once the formula is final. The label will always be the definitive
            source.
          </p>
        </details>

        <details name="faq-protein-energy" class:list={[item]}>
          <summary class:list={[question]}>
            <span>Is Protein Energy safe?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>
            Protein Energy will be formulated and manufactured as a dietary supplement according to the requirements
            applicable to its launch market. Follow the labeled serving size and speak with a healthcare professional
            if you have a medical condition, take medications or are sensitive to caffeine.
          </p>
        </details>

        <details name="faq-protein-energy" class:list={[item]}>
          <summary class:list={[question]}>
            <span>Who is Protein Energy for?</span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>
            Anyone who trains and wants a simple, mess-free way to add protein to their routine — lifters, runners, riders,
            swimmers and everyone in between. It's a dietary supplement, not a replacement for food, sleep or a doctor's advice.
          </p>
        </details>

        <details name="faq-protein-energy" class:list={[item]}>
          <summary class:list={[question]}>
            <span>
              When does Protein Energy launch?
            </span>
            <span aria-hidden="true" class:list={[plus]}>+</span>
          </summary>
          <p class:list={[answer]}>Soon, on the same pre-launch list as the rest of the <Brand /> family. Join to hear first.</p>
        </details>
      </ProductFaqGroup>
    </div>
  </div>
</section>
