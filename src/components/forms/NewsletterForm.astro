---
/**
 * Newsletter sign-up (MailerLite hosted form, double opt-in).
 *
 * - No request is made before the visitor submits.
 * - Without JavaScript the form still works as a plain POST to MailerLite (native validation applies).
 * - With JavaScript it submits via fetch and shows accessible status messages.
 * - All visible strings are HTML text in this file. The script only copies them from <template> elements.
 */
import { mailerLite, mailerLiteGroups, siteConfig, turnstile } from "@/config/site";
import { isPreviewState } from "@/config/variants";
import { products, type ProductId } from "@/config/products";
import ArrowIcon from "@/components/ui/ArrowIcon.astro";
import NewsletterSuccess from "./NewsletterSuccess.astro";
import Brand from "@/components/ui/Brand.astro";

interface Props {
  /** Unique suffix for element ids (the page has two forms on a page). */
  id: string;
  tone?: "light" | "dark";
  /** Product this form's page belongs to, if any: its checkbox starts checked (still changeable). */
  preselect?: ProductId;
}

const { id, tone = "light", preselect } = Astro.props;
const isDark = tone === "dark";
const state = siteConfig.formState;
const isLive = !isPreviewState(state);
const showSuccess = state === "success";
const showError = state === "error";
const isSubmitting = state === "submitting";

const fieldClasses = ["h-[60px] min-w-0 flex-1 rounded-full border-2 bg-white px-6 text-[19px] text-green", isDark ? "border-lime" : "border-green"];
const buttonClasses = [
  // Phones: a round arrow button beside the field. From sm up: the labelled pill from the design.
  "label-caps flex h-[60px] w-[60px] flex-none cursor-pointer items-center justify-center rounded-full border-2 px-0 text-[17px] transition duration-[180ms] hover:-translate-y-[3px] hover:scale-[1.03] active:scale-[0.97] disabled:cursor-wait disabled:opacity-70 sm:w-auto sm:px-8",
  isDark ? "border-pink bg-pink text-ink hover:border-green hover:bg-white hover:text-green" : "pulse-ring border-green bg-green text-pink hover:bg-white hover:text-green",
];
// Plain checkbox + label; the whole label is the click target.
const interestClasses = ["flex cursor-pointer items-center gap-2.5 text-base leading-normal"];
// The first flavor the community can pick. A free-text suggestion sits beside these two.
const flavors = [
  { id: "pineapple", label: "Pineapple" },
  { id: "energy", label: "Energy" },
] as const;
const FLAVOR_OTHER_MAX_LENGTH = 40;
const MESSAGE_MAX_LENGTH = 500;
const messageId = `newsletter-message-${id}`;
const flavorOtherId = `newsletter-flavor-other-${id}`;
const errorId = `newsletter-error-${id}`;
const emailId = `newsletter-email-${id}`;
const consentId = `newsletter-consent-${id}`;
---

<div data-newsletter data-endpoint={mailerLite.endpoint} data-live={isLive ? "true" : "false"} class:list={["text-left", isDark ? "on-dark" : ""]}>
  <div data-success-slot role="status" aria-live="polite" >
    {showSuccess && <NewsletterSuccess tone={tone} />}
  </div>

  <form data-newsletter-form method="post" action={mailerLite.endpoint || undefined} hidden={showSuccess} aria-busy={isSubmitting ? "true" : undefined}>
    <fieldset class="mb-5 min-w-0 border-0 p-0 text-center">
      <legend class="label-caps mx-auto text-center text-[clamp(1rem,1.6vw,1.2rem)] leading-[1.3]">
        Which <Brand /> line first? <span class="font-normal normal-case tracking-normal">(pick at least one)</span>
      </legend>
      <div class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-2.5">
        {products.map((product) => {
          const checkboxId = `newsletter-interest-${product.id}-${id}`;
          return (
            <label for={checkboxId} class:list={interestClasses}>
              <input
                id={checkboxId}
                type="checkbox"
                data-interest={product.id}
                data-group={mailerLiteGroups[product.id]}
                checked={preselect === product.id}
                class:list={["m-0 size-6 flex-none", isDark ? "accent-lime" : "accent-green"]}
              />
              <span>{product.name}</span>
            </label>
          );
        })}
      </div>
    </fieldset>

    <fieldset class="mb-5 min-w-0 border-0 p-0 text-center">
      <legend class="label-caps mx-auto text-center text-[clamp(1rem,1.6vw,1.2rem)] leading-[1.3]">
        Which flavor first? <span class="font-normal normal-case tracking-normal">(pick one or suggest your own)</span>
      </legend>
      <div class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-2.5">
        {flavors.map((flavor) => {
          const checkboxId = `newsletter-flavor-${flavor.id}-${id}`;
          return (
            <label for={checkboxId} class:list={interestClasses}>
              <input id={checkboxId} type="checkbox" data-flavor={flavor.id} class:list={["m-0 size-6 flex-none", isDark ? "accent-lime" : "accent-green"]} />
              <span>{flavor.label}</span>
            </label>
          );
        })}
        <label for={flavorOtherId} class="sr-only-important">Suggest your own flavor</label>
        <input
          id={flavorOtherId}
          type="text"
          name="fields[flavor_other]"
          data-flavor-other
          maxlength={FLAVOR_OTHER_MAX_LENGTH}
          autocomplete="off"
          placeholder="Your own flavor suggestion"
          class:list={["h-[60px] w-full min-w-0 rounded-full border-2 bg-white px-6 text-[19px] text-green sm:h-10 sm:w-[260px] sm:max-w-full sm:border sm:px-4 sm:text-sm", isDark ? "border-lime" : "border-green"]}
        />
      </div>
    </fieldset>

    <div class="mb-5">
      <label for={messageId} class="label-caps mx-auto block text-center text-[clamp(1rem,1.6vw,1.2rem)] leading-[1.3]">
        A message for us <span class="font-normal normal-case tracking-normal">(optional)</span>
      </label>
      <textarea
        id={messageId}
        name="fields[message]"
        data-message
        rows="3"
        maxlength={MESSAGE_MAX_LENGTH}
        autocomplete="off"
        spellcheck="true"
        placeholder="Anything you want us to know? Plain text, no links."
        class:list={["mt-3 block min-h-24 w-full resize-y rounded-3xl border-2 bg-white px-6 py-3.5 text-[19px] leading-snug text-green", isDark ? "border-lime" : "border-green"]}
      ></textarea>
    </div>

    <label for={emailId} class="label-caps mb-3 block text-center text-[clamp(1rem,1.6vw,1.2rem)] leading-[1.3]">
      Your email for the newsletter
    </label>
    <div class="flex gap-3">
      <input id={emailId} type="email" name="fields[email]" autocomplete="email" maxlength="254" placeholder="you@example.com" required aria-describedby={errorId} class:list={fieldClasses} />
      <button type="submit" disabled={isSubmitting} class:list={buttonClasses}>
        <ArrowIcon class="text-[26px] sm:hidden" />
        <span data-label-idle hidden={isSubmitting} class="sr-only sm:not-sr-only">
          Become a founding member
        </span>
        <span data-label-busy hidden={!isSubmitting} class="sr-only sm:not-sr-only">
          Sending…
        </span>
      </button>
    </div>


    <label for={consentId} class="mt-[18px] block cursor-pointer text-center text-base leading-normal">
      <input id={consentId} type="checkbox" name="consent" required class:list={["m-0 mr-1 inline-block size-6 align-middle", isDark ? "accent-lime" : "accent-green"]} />
      <span>
        I am 18 or older and agree to receive the <Brand /> newsletter: launch news and founding member emails. I can unsubscribe anytime. See our
        <a href="/privacy" class:list={[isDark ? "text-white" : ""]}>Privacy Policy</a>.
      </span>
    </label>

    {turnstile.siteKey && <div data-turnstile data-sitekey={turnstile.siteKey} class="mt-3 flex justify-center"></div>}
    {!mailerLite.endpoint && <noscript><p class="mt-3 text-center text-base font-bold">Please turn on JavaScript to sign up.</p></noscript>}

    <div aria-hidden="true" class="sr-only-important">
      <label for={`newsletter-website-${id}`}>Leave this field empty</label>
      <input id={`newsletter-website-${id}`} type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="ml-submit" value="1" />
    <input type="hidden" name="anticsrf" value="true" />

    <p id={errorId} role="alert" data-form-error hidden={!showError} class="mt-4 rounded-2xl bg-lime px-[18px] py-[13px] text-base font-bold text-ink">
      {showError && <>Something went wrong on our side. Try again.</>}
    </p>

    <slot name="after-error" />

    <p class:list={["mt-4 text-center text-sm leading-normal", isDark ? "opacity-80" : "opacity-85"]}>(No spam. Double opt-in: we email you a confirmation link first. Unsubscribe anytime.)</p>
  </form>

  <template data-message="invalid-email">That email doesn’t look right. Check it and try again.</template>
  <template data-message="lines">Please pick at least one version.</template>
  <template data-message="flavor">Please pick a flavor or suggest your own.</template>
  <template data-message="consent">Please confirm you are 18 or older and agree to the emails.</template>
  <template data-message="server">Something went wrong on our side. Try again.</template>
  <template data-message="already">You’re already on the list. Welcome back.</template>
  <template data-message="network">We couldn’t reach the list. Check your connection and try again.</template>
  <template data-message="challenge">We couldn’t check that you’re human. Please try again.</template>
  <template data-message="rate-limit">Too many tries in a row. Wait a moment and try again.</template>

  <template data-success-template>
    <NewsletterSuccess tone={tone} />
  </template>
</div>

<script>
  import { initNewsletter } from "@/scripts/newsletter";

  initNewsletter();
</script>
