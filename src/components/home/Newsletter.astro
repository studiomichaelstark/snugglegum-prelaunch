---
/**
 * Founding-member signup section. The copy (badge, heading, subline) comes in through slots. Under it
 * a three-step timeline (icons joined by a dashed line), then the form on a wide punched admission
 * ticket ("Admit one · No. ___ of 500").
 * `bgClass` is a literal Tailwind class from the caller. The ticket is a light surface, so the
 * form inside it always uses the light tone.
 */
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import type { ProductId } from '@/config/products';

interface Props {
  id: string;
  bgClass: string;
  tone?: 'light' | 'dark';
  preselect?: ProductId;
}
const { id, bgClass, tone = 'dark', preselect } = Astro.props;
const isDark = tone === 'dark';

// Icon paths are 24 x 24 stroke icons (Lucide, ISC license): user-plus, mail-check, star.
const steps = [
  {
    title: 'Sign up',
    text: 'Pick a version and a flavor, if you like.',
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M19 8v6 M22 11h-6',
  },
  {
    title: 'Confirm',
    text: 'One click on the link in your inbox.',
    icon: 'M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8 M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7 M16 19l2 2 4-4',
  },
  {
    title: 'Vote',
    text: 'Pineapple, Energy or your own idea.',
    icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',
  },
] as const;
---

<section id={`newsletter-${id}`} class:list={['section-px section-py relative isolate overflow-hidden', bgClass, isDark ? 'on-dark text-pink' : 'text-green']}>
  <!-- All three pouches, anchored to the very bottom of the section, behind the content. -->
  <!-- <Picture
    src={allThree}
    alt=""
    aria-hidden="true"
    formats={['avif', 'webp']}
    widths={[640, 1106]}
    sizes="(min-width: 1200px) 1106px, 100vw"
    loading="lazy"
    decoding="async"
    class="pointer-events-none absolute top-0 left-1/2 -z-10 h-auto w-[min(100%,1106px)] max-w-none -translate-x-1/2"
  /> -->
  <div class="container-lg grid grid-cols-[minmax(0,1fr)] gap-[clamp(40px,5vw,64px)]">
    <div class="mx-auto w-full max-w-[1040px] min-w-0 text-center">
      <slot name="badge" />
      <slot name="heading" />
      <slot name="subline" />

      <ol class="relative mx-auto mt-[clamp(36px,4.5vw,60px)] grid max-w-105 gap-7 text-left md:max-w-none md:grid-cols-3 md:gap-6 md:text-center md:before:pointer-events-none md:before:absolute md:before:top-8 md:before:right-[16.6%] md:before:left-[16.6%] md:before:border-t-2 md:before:border-dashed md:before:border-lime/70 md:before:content-['']">
        {
          steps.map((step, index) => (
            <li class="group relative z-10 flex items-start gap-5 md:flex-col md:items-center md:gap-4">
              <span class="relative flex size-16 flex-none items-center justify-center rounded-full bg-pink text-ink shadow-lg transition duration-300 group-hover:-translate-y-1 group-hover:rotate-6 group-hover:scale-110">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={step.icon} />
                </svg>
                <span aria-hidden="true" class="display-word absolute -top-1 -right-1 flex size-6 items-center justify-center rounded-full bg-lime text-xs text-ink">{index + 1}</span>
              </span>
              <span class="md:max-w-[26ch]">
                <span class="label-caps block text-base md:text-lg">{step.title}</span>
                <span class="mt-1 block text-base leading-normal opacity-90">{step.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="founding-ticket on-light sticker-shadow relative mx-auto w-full max-w-[980px] min-w-0 rounded-card bg-pink text-green transition duration-300 lg:rotate-[-1deg] lg:hover:rotate-0 lg:focus-within:rotate-0">
      <div class="flex h-(--ticket-stub) items-center justify-between gap-3 px-[clamp(20px,3vw,32px)]">
        <span class="label-caps text-xs sm:text-sm">Admit one</span>
        <span class="label-caps hidden text-xs sm:inline sm:text-sm">Founding member</span>
        <span class="label-caps text-xs sm:text-sm">No. ___ of 500</span>
      </div>
      <div aria-hidden="true" class="mx-5.5 border-t-2 border-dashed border-green/40"></div>
      <div class="px-[clamp(20px,4vw,56px)] pt-[clamp(20px,2.5vw,28px)] pb-[clamp(24px,3vw,36px)]">
        <NewsletterForm id={id} tone="light" preselect={preselect} />
      </div>
    </div>
  </div>
</section>
