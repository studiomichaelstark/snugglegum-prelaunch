---
/**
 * Homepage "How it works": Snack. Burst. Vitamins. Three short steps, no numbers about servings.
 * Each step is a tall stage with a big outlined step number behind a bursting gummy (decorative,
 * so alt is empty and the word carries the meaning). The cards are staggered, the gummies bob, and
 * on scroll the steps pop in one after another (src/scripts/howItWorks.ts). Without JavaScript or
 * under reduced motion everything is simply visible.
 */
import { Picture } from "astro:assets";
import blue from "@/assets/hero-03-snugglegum.png";
import orange from "@/assets/hero-02-snugglegum.png";
import green from "@/assets/hero-01-snugglegum.png";
import Brand from "@/components/ui/Brand.astro";

// Literal class strings so Tailwind's scanner sees every one.
const steps = [
  {
    word: "Snack",
    body: "Soft, chewy vitamin gummies you’ll actually reach for. Sugar-free, sweetened with sweeteners.",
    image: orange,
    card: "",
    bob: "animate-[sg-bob_5.5s_ease-in-out_infinite]",
    tilt: "group-hover:-rotate-6",
  },
  {
    word: "Burst",
    body: "Bite in and the liquid center bursts. That’s the whole trick.",
    image: green,
    card: "md:mt-[clamp(48px,6vw,96px)]",
    bob: "animate-[sg-bob_4.6s_ease-in-out_-1.4s_infinite]",
    tilt: "group-hover:rotate-6",
  },
  {
    word: "Vitamins",
    body: "Your vitamins, in a snack you actually look forward to.",
    image: blue,
    card: "md:mt-[clamp(16px,2vw,32px)]",
    bob: "animate-[sg-bob_6s_ease-in-out_-2.8s_infinite]",
    tilt: "group-hover:-rotate-3",
  },
];
---

<section id="how-it-works" aria-labelledby="how-heading" class="on-dark section-px section-py relative isolate overflow-hidden bg-charcoal text-white" data-how>
  <div class="container-lg">
    <p class="label-caps text-[17px] text-pink">How it works</p>
    <h2 id="how-heading" class="display-word stretch-display mt-3 text-[clamp(2.2rem,5vw,4.25rem)] leading-[0.88]">
      Snack. Burst. Vitamins.
    </h2>
    <p class="mt-4 max-w-[40ch] text-[clamp(1.2rem,1.9vw,1.5rem)] leading-[1.4] font-medium">Snack and burst poppin’ vitamin gummies.</p>
    <ol class="mt-[clamp(32px,4vw,56px)] grid gap-x-[clamp(24px,3vw,40px)] gap-y-[clamp(48px,6vw,64px)] md:grid-cols-3 short:grid-cols-3 short:gap-x-4">
      {
        steps.map((step, index) => (
          <li class:list={["how-step group relative", step.card]} data-how-step>
            <div class="relative">
              <span aria-hidden="true" data-decorative-text class="how-number display-word stretch-wide pointer-events-none absolute top-[-0.12em] left-[-0.04em] z-0 text-[clamp(6.5rem,12vw,10.5rem)] leading-[0.8] select-none">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="how-gummy relative z-10 ml-auto w-[78%] transition duration-500 ease-out short:w-[85%]">
                <div class:list={["transition duration-500 ease-out", step.tilt, "group-hover:scale-110"]}>
                  <Picture
                    src={step.image}
                    alt=""
                    aria-hidden="true"
                    formats={["avif", "webp"]}
                    widths={[420, 840]}
                    sizes="(min-width: 768px) 30vw, 80vw"
                    loading="lazy"
                    decoding="async"
                    class:list={["h-auto w-full drop-shadow-2xl", step.bob]}
                  />
                </div>
              </div>
            </div>
            <div class="relative z-10 mt-4 border-t-2 border-dashed border-white/20 pt-[clamp(16px,2vw,24px)]">
              <h3 class="text-[clamp(2.2rem,4vw,3.4rem)] leading-[0.95] font-black uppercase stretch-hero short:text-[1.6rem]">{step.word}</h3>
              <p class="mt-3.5 max-w-[34ch] text-xl leading-normal short:text-base">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-[clamp(40px,5vw,64px)] max-w-[60ch] text-xl leading-[1.6]">
      <strong><Brand /> vitamin gummies are in development</strong>. Serving size and daily gummies: see Supplement Facts (coming with launch).
    </p>
  </div>
</section>

<style>
  /* Outlined step number: transparent fill, pink outline, so the gummy in front stays the hero. */
  .how-number {
    color: transparent;
    -webkit-text-stroke: 2px color-mix(in srgb, var(--color-brand-pink) 75%, transparent);
  }

  /* Pop-in on scroll. Only active once the script has marked the section ready, so it is visible without JavaScript. */
  [data-how][data-ready] .how-step {
    opacity: 0;
    translate: 0 48px;
    transition:
      opacity 700ms ease-out,
      translate 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [data-how][data-ready] .how-step .how-gummy {
    scale: 0.55;
    rotate: -18deg;
  }

  [data-how][data-ready] .how-step[data-in] {
    opacity: 1;
    translate: 0 0;
  }

  [data-how][data-ready] .how-step[data-in] .how-gummy {
    scale: 1;
    rotate: 0deg;
    transition-duration: 900ms;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>

<script>
  import { initHowItWorks } from "@/scripts/howItWorks";

  initHowItWorks();
</script>
