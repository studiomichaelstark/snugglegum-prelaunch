# PUBLIC_ variables are exposed in the client bundle. The MailerLite IDs are not secret.
# Never put an API key or any other secret in a PUBLIC_ variable.
PUBLIC_MAILERLITE_ACCOUNT_ID=
PUBLIC_MAILERLITE_FORM_ID=
# Production origin without trailing slash, e.g. https://www.example.com (empty = placeholder URL)
PUBLIC_SITE_URL=
