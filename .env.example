# Everything the site still needs from you. Fill in the values, then run `pnpm check:placeholders`.
# The production build (`pnpm build`) fails until every required value is set.
#
# - Empty  = the page shows a visible [[TODO: …]] marker and the production build fails.
# - n/a    = for items marked "optional": leave the line or section out of the page.
# - Values with spaces need double quotes, e.g. PUBLIC_LEGAL_LOG_RETENTION="7 days"
# - PUBLIC_ variables are exposed in the client bundle, and all of these values are printed on public
#   pages anyway. The MailerLite IDs are not secret. Never put an API key or any secret here.

# ---- Site and MailerLite -----------------------------------------
# Canonical, sitemap, robots, llms.txt, Open Graph. Origin only, no trailing slash, e.g. https://www.example.com
PUBLIC_SITE_URL=

# Newsletter form endpoint. A public identifier, not a secret.
PUBLIC_MAILERLITE_ACCOUNT_ID=

# Newsletter form endpoint. A public identifier, not a secret.
PUBLIC_MAILERLITE_FORM_ID=

# ---- Contact -----------------------------------------------------
# Footer, imprint, and the privacy policy contact (unless PUBLIC_PRIVACY_EMAIL is set).
PUBLIC_CONTACT_EMAIL=

# Privacy policy contact. Leave empty to reuse PUBLIC_CONTACT_EMAIL.
PUBLIC_PRIVACY_EMAIL=

# ---- Imprint -----------------------------------------------------
# Imprint, section 2. Phone number, or for example "Contact form: https://…". Use n/a to omit the line. (optional)
PUBLIC_LEGAL_PHONE=

# Imprint, section 1. Register court and number. Use n/a if there is none. (optional)
PUBLIC_LEGAL_COMMERCIAL_REGISTER=

# Imprint, section 1. Use n/a if there is none. (optional)
PUBLIC_LEGAL_VAT_ID=

# Imprint, section 7. A full sentence. Use n/a to leave the whole section out. (optional)
PUBLIC_LEGAL_DISPUTE_RESOLUTION=

# ---- Privacy policy ----------------------------------------------
# Privacy policy, section 3. Completes "The website is hosted by …".
PUBLIC_LEGAL_HOSTING_PROVIDER=

# Privacy policy, section 3. Completes "Retention: …", for example "7 days".
PUBLIC_LEGAL_LOG_RETENTION=

# Privacy policy, section 7. Completes "Provider: …".
PUBLIC_LEGAL_MAILERLITE_ENTITY=

# Privacy policy, section 7. Describe tracking if it is on (and rely on consent). Use n/a if it is off. (optional)
PUBLIC_LEGAL_MAILERLITE_TRACKING=

# Privacy policy, section 9. Completes "the transfer relies on: …", per MailerLite's current DPA.
PUBLIC_LEGAL_TRANSFER_MECHANISM=

# Privacy policy, section 11.
PUBLIC_LEGAL_SUPERVISORY_AUTHORITY=

# Privacy policy, section 13. Extra paragraph. Use n/a if none is needed. (optional)
PUBLIC_LEGAL_US_STATE_PRIVACY=

# ---- Review ------------------------------------------------------
# Both legal pages, for example "September 22, 2026".
PUBLIC_LEGAL_LAST_UPDATED=

# Set to true after a lawyer has reviewed both pages. Removes the "Legal · draft" marker and notice.
PUBLIC_LEGAL_REVIEWED=

# ---- Offer (optional, empty = hidden) -------------------------
# Discount shown on the first offer card and in the FAQ, e.g. 15%. Empty hides the discount everywhere.
PUBLIC_DISCOUNT_LABEL=

# Number of confirmed subscribers. The "N people are already on the list" line shows only when this
# reaches PUBLIC_PROOF_THRESHOLD (default 250).
PUBLIC_SUBSCRIBER_COUNT=
PUBLIC_PROOF_THRESHOLD=
